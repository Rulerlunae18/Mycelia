// Модель даних Mycelia (розділ "Модель даних" у документі вимог).
// База: PostgreSQL (Supabase у продакшені, docker-compose локально). Типи свідомо прості
// (String, Json, @db.Text), тож схема переносима між СУБД.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Рядок для застосунку (у Supabase це пул з'єднань, порт 6543, ?pgbouncer=true)
  url       = env("DATABASE_URL")
  // Прямий рядок лише для міграцій (Supabase: session pooler, порт 5432). Локально збігається з DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  maps MindMap[]
}

// Названа MindMap, а не Map, щоб не перекривати вбудований клас Map у JS/TS.
model MindMap {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  theme     String   @default("default")
  layout    String   @default("radial") // radial | tree | bilateral
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  nodes      Node[]
  boundaries Boundary[]
  links      Link[]

  @@index([ownerId])
  @@map("maps")
}

// Дані для патерна Composite: parentId = null означає корінь карти.
model Node {
  id        String  @id @default(uuid())
  mapId     String
  parentId  String?
  text      String  @db.Text
  order     Int     @default(0)
  collapsed Boolean @default(false)
  style     Json?
  category  String? // значок категорії
  priority  String? // значок терміновості
  note      String? @db.Text // розгорнутий опис ідеї, що не влазить у вузол

  map         MindMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  parent      Node?        @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Node[]       @relation("NodeTree")
  attachments Attachment[]
  linksFrom   Link[]       @relation("LinkFrom")
  linksTo     Link[]       @relation("LinkTo")

  @@index([mapId])
  @@index([parentId])
}

// Сам файл лежить у сховищі (Supabase Storage), тут тільки ключ.
model Attachment {
  id         String   @id @default(uuid())
  nodeId     String
  kind       String // file | image | video
  name       String
  mime       String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
}

// Область карти, обведена пунктиром.
model Boundary {
  id      String  @id @default(uuid())
  mapId   String
  label   String?
  nodeIds Json // масив id вузлів області

  map MindMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@index([mapId])
}

// Зв'язок між двома вузлами однієї карти (стрілка «від → до» поза деревом).
// Зникає разом з будь-яким із вузлів. Пара (fromId, toId) унікальна.
model Link {
  id     String  @id @default(uuid())
  mapId  String
  fromId String
  toId   String
  label  String?

  map  MindMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  from Node    @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Node    @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([mapId])
}

// Джерело для патерна Prototype (створення карти із шаблону).
model Template {
  id           String @id @default(uuid())
  title        String
  treeSnapshot Json
}
