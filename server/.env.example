# Скопіюй у server/.env і підстав свої значення. Файл .env у git не потрапляє.

# ── База даних (PostgreSQL) ──
# Локально: `docker compose up -d` у корені проєкту, рядки нижче готові до роботи.
DATABASE_URL="postgresql://mycelia:mycelia@localhost:5432/mycelia"
DIRECT_URL="postgresql://mycelia:mycelia@localhost:5432/mycelia"
# Supabase (продакшен): Project Settings → Database → Connection string → Connection pooling.
#   DATABASE_URL = Transaction pooler, порт 6543, з ?pgbouncer=true
#     postgresql://postgres.<ref>:<пароль>@aws-0-<регіон>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL   = Session pooler, порт 5432 (для міграцій; прямий хост Supabase лише IPv6, Render його не бачить)
#     postgresql://postgres.<ref>:<пароль>@aws-0-<регіон>.pooler.supabase.com:5432/postgres

# ── Авторизація ──
# Довгий випадковий рядок. Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
# Час життя токена в секундах (3600 = 1 година)
JWT_EXPIRES_SECONDS=3600

PORT=3000
# Адреса клієнта для CORS (у розробці це Vite). У продакшені клієнт і API на одному домені, тут нічого міняти не треба.
CLIENT_ORIGIN="http://localhost:5173"
COOKIE_SAMESITE=lax

# ── Вкладені файли ──
# Без Supabase файли лежать у папці (типово server/uploads, вона в .gitignore).
# UPLOAD_DIR=./uploads
# З Supabase Storage (продакшен): приватний бакет і сервісний ключ (Project Settings → API → service_role).
# Ключ має лише сервер, у браузер він не потрапляє. Не коміть його.
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_KEY="..."
# SUPABASE_BUCKET="attachments"
