# Скопіюй у .env і підстав свої значення.

# MySQL для розробки. Після переходу на Supabase тут буде рядок PostgreSQL
# (і provider у prisma/schema.prisma зміниться на "postgresql").
DATABASE_URL="mysql://root:RulerLovesYou@localhost:3306/mycelia"

# Довгий випадковий рядок. Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="a00d4c6ae04ec2aa25d6536c0ab16fa8aca3006df66ef6f22bf3c1508c82364bbbd0fe8e642693e232c3c659f90ed330"
# Час життя токена в секундах (3600 = 1 година)
JWT_EXPIRES_SECONDS=3600

PORT=3000
# Адреса клієнта для CORS (у розробці це Vite)
CLIENT_ORIGIN="http://localhost:5173"

# Для клієнта і API на різних доменах (Render) постав COOKIE_SAMESITE=none
# і NODE_ENV=production, тоді cookie буде ще й Secure.
COOKIE_SAMESITE=lax
